# Copy this file to .env and fill it in:  cp .env.example .env

# Your Claude API key from https://platform.claude.com (separate from a Claude.ai subscription)
ANTHROPIC_API_KEY=

# Password for the dashboard (at least 8 characters)
APP_PASSWORD=

# Which Claude model runs the agent:
#   claude-sonnet-5-5  good all-rounder (default)
#   claude-haiku-5-5   much cheaper, fine for simple tasks
MODEL=claude-sonnet-5-5

# Spending caps in US dollars
JOB_BUDGET_USD=0.50
DAILY_BUDGET_USD=2.00

# Most tool-use rounds one job can take
MAX_STEPS=15

# Claude's built-in web search ($10 per 1,000 searches). Set to off to disable.
WEB_SEARCH=on

PORT=8787
TIMEZONE=Europe/London
